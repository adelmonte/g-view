[Desktop Entry]
Name=g-view
GenericName=Image Viewer
Type=Application
Exec=g-view %U
Icon=g-view
StartupNotify=true
StartupWMClass=g-view
Comment=Minimal image viewer (GTK3 port of qView)
Keywords=photos;pictures;jpeg;png;gif;webp;
Categories=GTK;Graphics;Viewer;Photography;
Terminal=false
MimeType=image/bmp;image/x-win-bitmap;image/gif;image/x-icon;image/vnd.microsoft.icon;image/jpeg;image/jpg;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-portable-anymap;image/png;image/apng;image/svg+xml;image/svg+xml-compressed;image/tiff;image/webp;image/x-tga;image/x-exr;image/vnd.radiance;image/qoi;image/x-dds;image/x-xbitmap;image/x-xpixmap;
